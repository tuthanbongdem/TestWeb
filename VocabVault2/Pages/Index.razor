@page "/"
@inject DataService DS
@implements IDisposable

<PageTitle>VocabVault</PageTitle>

@if (!_ready)
{
    <div class="boot-screen">
        <div class="boot-spinner"></div>
        <div>Đang tải dữ liệu...</div>
    </div>
}
else
{
    <div class="app">
        <nav class="sidebar">
            <div class="brand">V<span>V</span></div>
            <div class="nav-links">
                <button class="nav-btn @(Tab=="vocab"?"active":"")"    @onclick='()=>Tab="vocab"'>
                    <span class="nav-icon">📖</span><span class="nav-label">Từ vựng</span>
                </button>
                <button class="nav-btn @(Tab=="quiz"?"active":"")"     @onclick='()=>Tab="quiz"'>
                    <span class="nav-icon">⚡</span><span class="nav-label">Quiz</span>
                </button>
                <button class="nav-btn @(Tab=="speaking"?"active":"")" @onclick='()=>Tab="speaking"'>
                    <span class="nav-icon">🎤</span><span class="nav-label">Speaking</span>
                </button>
                <button class="nav-btn @(Tab=="add"?"active":"")"      @onclick='()=>Tab="add"'>
                    <span class="nav-icon">＋</span><span class="nav-label">Thêm mới</span>
                </button>
            </div>
            <div class="sidebar-stats">
                <div class="ss-row"><span>📖</span> @DS.Words.Count từ</div>
                <div class="ss-row"><span>🎤</span> @DS.Phrases.Count câu</div>
                <div class="ss-row"><span>⭐</span> @DS.Words.Count(w=>w.Favorite) yêu thích</div>
            </div>
        </nav>
        <main class="content">
            @if (Tab == "vocab")    { <VocabPage /> }
            @if (Tab == "quiz")     { <QuizPage /> }
            @if (Tab == "speaking") { <SpeakingPage /> }
            @if (Tab == "add")      { <AddPage /> }
        </main>
    </div>
}

@code {
    string Tab = "vocab";
    bool _ready = false;

    protected override void OnInitialized() => DS.OnChange += StateHasChanged;

    protected override async Task OnInitializedAsync()
    {
        await DS.LoadAsync();
        _ready = true;
    }

    public void Dispose() => DS.OnChange -= StateHasChanged;
}
