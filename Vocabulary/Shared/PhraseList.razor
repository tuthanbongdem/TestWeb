@using Vocabulary.Pages

<!-- ══ EDIT MODAL ══════════════════════════════════════════════════════════ -->
@if (EditP != null)
{
    <div class="modal-backdrop" @onclick="CloseEdit">
        <div class="modal-box" @onclick:stopPropagation="true">
            <div class="modal-header">
                <span>✏️ Chỉnh sửa câu</span>
                <button class="modal-close" @onclick="CloseEdit">✕</button>
            </div>
            <div class="modal-body">
                <div class="add-form-grid">
                    <div class="afg afg-full">
                        <label>Câu tiếng Anh *</label>
                        <textarea @bind="EditP.English" rows="2" placeholder="e.g. Could you say that again, please?"></textarea>
                    </div>
                    <div class="afg afg-full">
                        <label>Nghĩa tiếng Việt *</label>
                        <input @bind="EditP.Vietnamese" placeholder="e.g. Bạn có thể nói lại không?" />
                    </div>
                    <div class="afg">
                        <label>Tình huống</label>
                        <select @bind="EditP.Situation">
                            @foreach (var s in Situations)
                            { <option value="@s">@s</option> }
                        </select>
                    </div>
                    <div class="afg">
                        <label>Ghi chú</label>
                        <input @bind="EditP.Note" placeholder="e.g. Dùng khi họp, lịch sự" />
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(EditErr)) { <p class="err-txt">@EditErr</p> }
            </div>
            <div class="modal-footer">
                <button class="ghost-btn" @onclick="CloseEdit">Huỷ</button>
                <button class="big-btn @(EditOk?"btn-ok":"")" @onclick="SaveEdit">
                    @(EditOk ? "✓ Đã lưu!" : "💾 Lưu thay đổi")
                </button>
            </div>
        </div>
    </div>
}

@if (!Phrases.Any())
{
    <div class="empty">
        <div class="empty-ico">🎤</div>
        <p>Chưa có câu nào phù hợp. Thêm câu mới nhé!</p>
    </div>
}
else
{
    <div class="phrase-list">
        @foreach (var p in Phrases)
        {
            var isActive = ActiveId == p.Id;
            var pId = p.Id;
            var pEn = p.English;

            <div class="pcard @(isActive ? "pcard-active" : "")">
                <div class="pcard-header">
                    <span class="sit-badge sit-@p.Situation.ToLower()">@p.Situation</span>
                    <div class="pcard-actions">
                        <SpeakBtn Text="@p.English" />
                        <button class="icon-btn @(p.Favorite ? "fav-on" : "")" @onclick="() => OnToggleFav.InvokeAsync(pId)">♥</button>
                        <button class="icon-btn edit" title="Chỉnh sửa" @onclick="() => OpenEdit(p)">✏</button>
                        <button class="icon-btn del" @onclick="() => OnDelete.InvokeAsync(pId)">✕</button>
                    </div>
                </div>

                <div class="pcard-en">@p.English</div>
                <div class="pcard-vn">@p.Vietnamese</div>

                @if (!string.IsNullOrEmpty(p.Note))
                {
                    <div class="pcard-note"><span class="note-ico">💡</span> @p.Note</div>
                }

                <div class="pronun-section">
                    <button class="pronun-trigger @(isActive && RecogState != "idle" ? "active-mic" : "")"
                            @onclick="() => OnToggleChecker.InvokeAsync((pId, pEn))">
                        @if (isActive && RecogState == "listening")
                        {
                            <span class="mic-pulse">🎙️</span>
                            <span> Đang nghe... (nhấn để dừng)</span>
                        }
                        else if (isActive && RecogState == "processing")
                        {
                            <span>⏳ Đang chấm điểm...</span>
                        }
                        else
                        {
                            <span>🎤 Kiểm tra phát âm</span>
                        }
                    </button>

                    @if (isActive && !SpeechSupported)
                    {
                        <div class="recog-unsupported">⚠️ Dùng <b>Chrome</b> hoặc <b>Edge</b> để dùng tính năng này!</div>
                    }

                    @if (isActive && Result != null)
                    {
                        <PronunResultCard R="Result" OnSlow="OnSlow" OnFast="OnFast" OnRetry="OnRetry" />
                    }
                </div>
            </div>
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<Phrase> Phrases { get; set; } = new List<Phrase>();
    [Parameter] public int ActiveId { get; set; }
    [Parameter] public string RecogState { get; set; } = "idle";
    [Parameter] public bool SpeechSupported { get; set; } = true;
    [Parameter] public SpeakingPage.PronunResultData? Result { get; set; }

    [Parameter] public EventCallback<(int, string)> OnToggleChecker { get; set; }
    [Parameter] public EventCallback<int> OnToggleFav { get; set; }
    [Parameter] public EventCallback<int> OnDelete { get; set; }
    [Parameter] public EventCallback<Phrase> OnEditSave { get; set; }
    [Parameter] public EventCallback OnSlow { get; set; }
    [Parameter] public EventCallback OnFast { get; set; }
    [Parameter] public EventCallback OnRetry { get; set; }

    static readonly string[] Situations = { "Daily", "Meeting", "Travel", "Study", "Other" };

    // ── Edit state ────────────────────────────────────────────────────────────
    Phrase? EditP  = null;
    string  EditErr = "";
    bool    EditOk  = false;

    void OpenEdit(Phrase p)
    {
        EditP = new Phrase
        {
            Id = p.Id, English = p.English, Vietnamese = p.Vietnamese,
            Note = p.Note, Situation = p.Situation,
            Favorite = p.Favorite, CreatedAt = p.CreatedAt
        };
        EditErr = ""; EditOk = false;
    }

    void CloseEdit() { EditP = null; EditErr = ""; EditOk = false; }

    async Task SaveEdit()
    {
        if (EditP == null) return;
        EditErr = "";
        if (string.IsNullOrWhiteSpace(EditP.English) || string.IsNullOrWhiteSpace(EditP.Vietnamese))
        { EditErr = "⚠ Vui lòng nhập câu và nghĩa!"; return; }
        await OnEditSave.InvokeAsync(EditP);
        EditOk = true;
        await Task.Delay(1200);
        CloseEdit();
    }
}
